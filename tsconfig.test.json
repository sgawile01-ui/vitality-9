{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/convex/*": ["./convex/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["tests", "vitest.config.ts", "playwright.config.ts"]
}
