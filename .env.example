# Public frontend configuration. Use a dedicated synthetic-testing OIDC client.
VITE_CONVEX_URL=
VITE_HERCULES_OIDC_AUTHORITY=
VITE_HERCULES_OIDC_CLIENT_ID=
# Configure these separately on the local/test Convex backend, never with VITE_ prefixes.
HERCULES_OIDC_AUTHORITY=
HERCULES_OIDC_CLIENT_ID=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Payment operations are disabled in code for controlled synthetic testing.
