# Public frontend configuration. Use a dedicated synthetic-testing OIDC client.
VITE_CONVEX_URL=
VITE_HERCULES_OIDC_AUTHORITY=
VITE_HERCULES_OIDC_CLIENT_ID=
# Configure these separately on the local/test Convex backend, never with VITE_ prefixes.
HERCULES_OIDC_AUTHORITY=
HERCULES_OIDC_CLIENT_ID=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Payment operations are disabled in code for controlled synthetic testing.

# Backend-only controlled beta settings (set privately on the selected Convex deployment).
# Restricted mode is also the safe default when BETA_MODE is absent.
BETA_MODE=restricted
BETA_ALLOWED_SUBJECTS=
APP_ORIGIN=
# Only test mode is supported; never configure live keys.
PAYMENTS_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Optional Vercel Production-only CI credential for combined Convex/frontend deployment.
CONVEX_DEPLOY_KEY=
